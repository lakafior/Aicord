    "The Last %@" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnie: %@"
          }
        }
      }
    },
    "Messages they sent in that time are deleted from the whole server." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomości wysłane przez tę osobę w tym czasie zostaną usunięte z całego serwera."
          }
        }
      }
    },
    "Reason (optional)" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powód (opcjonalnie)"
          }
        }
      }
    },
    "Shown in the server's audit log." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widoczny w dzienniku audytu serwera."
          }
        }
      }
    },
    "They can still read the server, but can't send messages, react, talk or join voice until the timeout ends." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do końca timeoutu ta osoba może czytać serwer, ale nie może pisać, reagować, mówić ani dołączać do głosowych."
          }
        }
      }
    },
    "They can talk again right away." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta osoba od razu może znów pisać."
          }
        }
      }
    },
    "They're removed from the server and can come back with an invite." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta osoba zostanie usunięta z serwera i może wrócić z zaproszeniem."
          }
        }
      }
    },
    "They're removed from the server and can't come back, even with an invite, until they're unbanned." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta osoba zostanie usunięta z serwera i nie wróci nawet z zaproszeniem, dopóki nie zostanie odbanowana."
          }
        }
      }
    },
    "You can only give and take roles below your highest one." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz nadawać i odbierać tylko role poniżej swojej najwyższej."
          }
        }
      }
    },
